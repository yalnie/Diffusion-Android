<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/nav_graph"
	android:label="@string/app_name"
	app:startDestination="@id/libraryFragment">
	<fragment
		android:id="@+id/libraryFragment"
		android:name="su.xash.diffusion.ui.library.LibraryFragment"
		android:label="@string/app_name">
		<action
			android:id="@+id/action_libraryFragment_to_discordAuthFragment"
			app:destination="@id/discordAuthFragment" />
	</fragment>
	<fragment
		android:id="@+id/crashLogsFragment"
		android:name="su.xash.diffusion.ui.settings.CrashLogsFragment"
		android:label="@string/crash_logs" />
	<fragment
		android:id="@+id/discordAuthFragment"
		android:name="su.xash.diffusion.ui.discord.DiscordAuthFragment"
		android:label="@string/discord_rpc" />
</navigation>
