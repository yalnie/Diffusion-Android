<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/storage_settings">
        <su.xash.diffusion.ui.settings.GamePathPreference
            app:key="game_path"
            app:icon="@drawable/ic_outline_folder_24"
            app:title="@string/game_data_location"
            app:widgetLayout="@layout/preference_game_path_widget"
            app:summary="Storage path will be updated automatically" />
            
        <SwitchPreferenceCompat
            app:key="storage_toggle"
            app:icon="@drawable/ic_outline_drive_file_move_24"
            app:title="@string/toggle_storage_location"
            app:summaryOn="@string/using_internal_storage"
            app:summaryOff="@string/using_external_storage"
            app:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/global_settings">
        <SwitchPreferenceCompat
            app:key="microphone"
            app:icon="@drawable/ic_outline_mic_24"
            app:title="@string/microphone"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="use_volume_buttons"
            app:icon="@drawable/ic_outline_volume_up_24"
            app:title="@string/game_settings_volume_buttons"
            app:defaultValue="false" />

        <Preference
            app:key="global_arguments"
            app:icon="@drawable/ic_outline_terminal_24"
            app:title="@string/global_command_line"
            app:summary="set any arguments" />

        <Preference
            app:key="render_resolution"
            app:icon="@drawable/ic_outline_aspect_ratio_24"
            app:title="@string/render_resolution"
            app:summary="@string/render_resolution_summary" />

        <SwitchPreferenceCompat
            app:key="stretch_resolution"
            app:icon="@drawable/ic_outline_fullscreen_24"
            app:title="@string/stretch_resolution"
            app:summary="@string/stretch_resolution_summary"
            app:defaultValue="false" />

        <SwitchPreferenceCompat
            app:key="keyboard_pans_screen"
            app:icon="@drawable/ic_outline_keyboard_24"
            app:title="@string/keyboard_pans_screen"
            app:summary="@string/keyboard_pans_screen_summary"
            app:defaultValue="true" />

        <SwitchPreferenceCompat
            app:key="fix_font"
            app:icon="@drawable/ic_outline_text_fields_24"
            app:title="@string/fix_font"
            app:summary="@string/fix_font_summary"
            app:defaultValue="true" />

        <Preference
            app:key="share_engine_log"
            app:icon="@drawable/ic_outline_bug_report_24"
            app:title="@string/share_engine_log" />
    </PreferenceCategory>

</PreferenceScreen>
